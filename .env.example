# =============================================================================
# Sarvam Associates — environment
#
# Copy to `.env.local` for development, or set these on the host in production.
# Nothing here has a safe default except in development; see the notes.
# =============================================================================

# --- Required before the financial planner can go live -----------------------

# Signs the plan-access and admin cookies, and hashes OTP codes. At least 32
# characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In development a throwaway key is generated per process; in production the
# server refuses to start the planner without this.
PLAN_SECRET=

# Password for /admin. At least 8 characters. Until this is set, the admin
# panel returns "not set up yet" rather than letting anyone in.
ADMIN_PASSWORD=

# --- SMS delivery for the OTP ------------------------------------------------
# One of: msg91 | twilio | webhook | console
# Unset (or `console`) logs the code to the terminal in development and REFUSES
# to send in production, rather than silently dropping it.
SMS_PROVIDER=

# MSG91 (India; needs a DLT-approved template containing ##OTP##)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Hand the send to an endpoint you already run
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# --- Storage -----------------------------------------------------------------
# Set DATABASE_URL and the planner uses Postgres. Leave it blank and it writes
# JSON files to PLAN_DATA_DIR instead. That is the whole switch — no flag, no
# build setting. The table is created on first use.
#
# On Vercel, attaching Neon (Storage -> Create Database -> Neon) injects
# DATABASE_URL and POSTGRES_URL for you — there is nothing to paste. Use the
# POOLED string, which is what those two hold by default.
#
# READ THIS BEFORE DEPLOYING:
# A cloud host CANNOT reach a database on your own PC. "localhost" inside a
# Vercel function means Vercel's server, not yours. Either use a database that
# is reachable from the internet (Neon, Supabase, Railway, or your own server
# with a public address) or host the whole site somewhere that can see your
# database. Run `npm run check:db` to test whichever machine you are on.
#
# The file-store fallback does NOT work on Vercel, Netlify or Lambda at all —
# their filesystems are read-only, so the first submission fails with EROFS.
DATABASE_URL=

# Verify the database's TLS certificate. Leave unset. Set to true ONLY for a
# server using a self-signed certificate, and only knowingly: it disables the
# check that stops someone intercepting the connection.
DATABASE_SSL_NO_VERIFY=

# Connections held per server instance. Default 3, which suits serverless —
# many short-lived instances each opening a big pool is how a small database
# runs out of connections.
DATABASE_POOL_MAX=

# Only used when DATABASE_URL is blank. Defaults to ./.data/plans
PLAN_DATA_DIR=

# --- Consultation form -------------------------------------------------------
# Where consultation leads are POSTed. Unset means they are accepted and logged
# in development, and accepted but delivered nowhere in production.
LEAD_WEBHOOK_URL=
