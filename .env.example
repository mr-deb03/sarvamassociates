# =============================================================================
# Sarvam Associates — environment
#
# Copy to `.env.local` for development, or set these on the host in production.
# Nothing here has a safe default except in development; see the notes.
# =============================================================================

# --- Required before the financial planner can go live -----------------------

# Signs the plan-access and admin cookies, and hashes OTP codes. At least 32
# characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In development a throwaway key is generated per process; in production the
# server refuses to start the planner without this.
PLAN_SECRET=

# Password for /admin. At least 8 characters. Until this is set, the admin
# panel returns "not set up yet" rather than letting anyone in.
ADMIN_PASSWORD=

# --- SMS delivery for the OTP ------------------------------------------------
# One of: msg91 | twilio | webhook | console
# Unset (or `console`) logs the code to the terminal in development and REFUSES
# to send in production, rather than silently dropping it.
SMS_PROVIDER=

# MSG91 (India; needs a DLT-approved template containing ##OTP##)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Hand the send to an endpoint you already run
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# --- Storage -----------------------------------------------------------------
# Where plan submissions are written. Defaults to ./.data/plans
# NOTE: the default file store does NOT survive a deploy on Vercel, Netlify or
# Lambda. On those hosts, swap getStore() in lib/plan/store.ts for a database.
PLAN_DATA_DIR=

# --- Consultation form -------------------------------------------------------
# Where consultation leads are POSTed. Unset means they are accepted and logged
# in development, and accepted but delivered nowhere in production.
LEAD_WEBHOOK_URL=
